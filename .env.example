# Local development. Copy to .env and fill in.
# Phase 2 (Supabase Postgres): both come from your Supabase project's
# "Connection string" page — DATABASE_URL is the pooled/Transaction URL,
# DIRECT_URL is the Session-mode URL on port 5432.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Supabase Storage (member photo uploads). Service-role key — server only.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_STORAGE_BUCKET="uploads"
